---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Comments from '../components/Comments.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  prev?: { id: string; title: string } | null;
  next?: { id: string; title: string } | null;
}

const { post, prev = null, next = null } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags, draft } = post.data;
---

<BaseLayout title={title} description={description}>
  <article>
    <header class="post-header">
      <span class="card-meta">
        <FormattedDate date={pubDate} />
        {updatedDate && <> · updated <FormattedDate date={updatedDate} /></>}
        {draft && <span class="draft-badge">Draft</span>}
      </span>

      <h1>{title}</h1>
      <p class="lede">{description}</p>

      {tags.length > 0 && (
        <ul class="tag-list">
          {tags.map((tag) => (
            <li><a class="tag" href={`/tags/${tag}/`}>#{tag}</a></li>
          ))}
        </ul>
      )}
    </header>

    {heroImage && <img class="hero-image" src={heroImage} alt="" loading="eager" />}

    <div class="prose">
      <slot />
    </div>
  </article>

  {(prev || next) && (
    <nav class="post-nav" aria-label="More posts">
      <span>
        {prev && <><span style="color:var(--text-muted)">← </span><a href={`/blog/${prev.id}/`}>{prev.title}</a></>}
      </span>
      <span style="text-align:right">
        {next && <><a href={`/blog/${next.id}/`}>{next.title}</a><span style="color:var(--text-muted)"> →</span></>}
      </span>
    </nav>
  )}

  <Comments />
</BaseLayout>
