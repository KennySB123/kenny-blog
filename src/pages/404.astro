---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="That page doesn't exist." noSearch>
  <div style="text-align:center;padding-block:4rem">
    <p style="font-size:5rem;margin:0;line-height:1">🫥</p>
    <h1>Nothing here</h1>
    <p style="color:var(--text-muted)">
      That page doesn't exist, or it moved and I forgot to leave a note.
    </p>
    <p style="margin-top:2rem">
      <a class="button" href="/">Back home</a>
    </p>
  </div>
</BaseLayout>
