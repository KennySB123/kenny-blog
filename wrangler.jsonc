{
  // Deploys the blog as static assets on Cloudflare Workers.
  // This is NOT an SSR adapter — it just points Cloudflare at the
  // already-built static output in ./dist. The site stays 100% static.
  "name": "kenny-blog",
  "compatibility_date": "2025-05-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
